{
  "name": "receipt-management-system",
  "version": "1.0.0",
  "description": "Multi-user sales receipt management system with A4-printable receipts",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "build:win": "pkg . --targets node18-win-x64 --output dist/receipt-system.exe --compress GZip"
  },
  "pkg": {
    "scripts": [
      "server/**/*.js"
    ],
    "assets": [
      "public/**/*",
      "node_modules/better-sqlite3/build/Release/*.node"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "dotenv": "^16.4.5"
  }
}